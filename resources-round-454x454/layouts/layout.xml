<resources>
    <layout id="main">
        <drawable id="background" />
        <drawable id="foreground" />

        <drawable id="analogClock" class="AnalogClockView">
            <param name="locX">227</param>
            <param name="locY">195</param>
            <param name="hourHandResId">@Drawables.HourHand</param>
            <param name="minuteHandResId">@Drawables.MinuteHand</param>
        </drawable>

        <drawable id="sunset" class="SunsetView">
            <param name="locX">227</param>
            <param name="locY">227</param>
            <param name="radius">226</param>
        </drawable>

        <drawable id="barometer" class="BarometerView">
            <param name="locX">98</param>
            <param name="locY">154</param>
            <param name="height">16.0</param>
            <param name="color">0x55AAAA</param>
            <param name="sensor">:getPressureHistory</param>
            <param name="labelScale">100.0</param>
        </drawable>
        <label id="barometerLabel" visible="true" x="106" y="80" text="1013" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <drawable id="heartRate" class="BarometerView">
            <param name="locX">410</param>
            <param name="locY">154</param>
            <param name="height">16.0</param>
            <param name="color">0xFF5500</param>
            <param name="sensor">:getHeartRateHistory</param>
            <param name="labelScale">1.0</param>
        </drawable>
        <label id="heartRateLabel" visible="true" x="349" y="82" text="75" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <drawable id="stepsHistory" class="StepsView">
            <param name="locX">418</param>
            <param name="locY">295</param>
            <param name="height">16.0</param>
            <param name="color">0x55AAAA</param>
            <param name="labelScale">1.0</param>
        </drawable>
        <label id="stepsCount" visible="true" x="395" y="212" text="12345" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <drawable id="battery" class="BatteryView">
            <param name="locX">227</param>
            <param name="locY">400</param>
        </drawable>
        <label id="batteryLabel" visible="true" x="227" y="414" text="80%" color="#FFFFFF" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <label id="currentTime" visible="true" x="227" y="300" text="10:10" color="#FFFFFF" font="Graphics.FONT_LARGE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="date" visible="true" x="56" y="200" text="JAN 01" color="#FF5500" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="month" visible="true" x="56" y="232" text="JAN 01" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="weekDay" visible="true" x="60" y="261" text="MON" color="#55AAAA" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="energyLevel" visible="false" x="280" y="406" text="80%" color="#AAAAAA" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <label id="solarCharging" visible="true" x="130" y="315" text="5" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="bluetooth" visible="true" x="130" y="348" text="5" color="#55AAAA" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="alarm" visible="true" x="318" y="315" text="0" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="vibrate" visible="true" x="318" y="348" text="8" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />

        <drawable id="secondsClock" class="SecondsClockView">
            <param name="locX">227</param>
            <param name="locY">195</param>
            <param name="rezId">@Drawables.SecondsHand</param>
        </drawable>

        <drawable id="infoWeather" class="InfoWeather">
            <param name="locX">177</param>
            <param name="locY">20</param>
            <param name="width">80</param>
            <param name="color">0x55AAAA</param>
        </drawable>
    </layout>

</resources>