<resources>
    <layout id="main">
        <drawable id="background" />
        <drawable id="foreground" />
        <drawable id="analogClock" class="AnalogClockView">
            <param name="locX">cfg.clockX</param>
            <param name="locY">cfg.clockY</param>
            <param name="hourHandResId">@Drawables.HourHand</param>
            <param name="minuteHandResId">@Drawables.MinuteHand</param>
        </drawable>
        <label id="currentTime" visible="true" x="227" y="300" text="10:10" color="#FFFFFF" font="Graphics.FONT_LARGE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="date" visible="true" x="56" y="200" text="JAN 01" color="#FF5500" font="Graphics.FONT_TINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="month" visible="true" x="56" y="232" text="JAN 01" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="weekDay" visible="true" x="60" y="261" text="MON" color="#55AAAA" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="stepsCount" visible="true" x="392" y="212" text="12345" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="heartRate" visible="true" x="349" y="82" text="75" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="energyLevel" visible="false" x="140" y="203" text="80%" color="#AAAAAA" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="barometer" visible="true" x="106" y="80" text="1013" color="#FFFFFF" font="Graphics.FONT_GLANCE" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="battery" visible="true" x="227" y="414" text="80%" color="#FFFFFF" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="solarCharging" visible="true" x="134" y="305" text="5" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="bluetooth" visible="true" x="134" y="337" text="5" color="#55AAAA" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="alarm" visible="true" x="318" y="305" text="\uE190" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <label id="vibrate" visible="true" x="318" y="337" text="\uE62D" color="#000055" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" />
        <drawable id="secondsClock" class="SecondsClockView">
            <param name="locX">cfg.clockX</param>
            <param name="locY">cfg.clockY</param>
            <param name="rezId">@Drawables.SecondsHand</param>
        </drawable>
        <drawable id="infoWeather" class="InfoWeather">
            <param name="locX">170</param>
            <param name="locY">25</param>
            <param name="width">80</param>
            <param name="color">0x55AAAA</param>
        </drawable>
    </layout>
</resources>