fr255.resourcePath = $(fenix7.resourcePath)
fr255m.sourcePath = $(fenix7.sourcePath)
fr255m.resourcePath = $(fenix7.resourcePath)
fr955.sourcePath = $(fenix7.sourcePath)
fr955.resourcePath = $(fenix7.resourcePath)
fenix8solar47mm.sourcePath = $(fenix7.sourcePath)
fenix8solar47mm.resourcePath = $(fenix7.resourcePath)
fenix9prosolar47mm.sourcePath = $(fenix7.sourcePath)
fenix9prosolar47mm.resourcePath = $(fenix7.resourcePath)

fenix7x.sourcePath = $(srcBase);src-fenix7x-280x280;src-weather-api
