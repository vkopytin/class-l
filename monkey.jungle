fenix847mm.resourcePath = $(fr965.resourcePath)
fenix8pro47mm.sourcePath = $(fr965.sourcePath)
fenix8pro47mm.resourcePath = $(fr965.resourcePath)
venu3.sourcePath = $(fr965.sourcePath)
venu3.resourcePath = $(fr965.resourcePath)

# 416x416 OLED layout and artwork derived from FR965.
venu2.sourcePath = $(srcBase);src-venu2-416x416
venu2.resourcePath = $(base.resourcePath);resources-round-416x416

# Additional Fenix 8/9 variants reuse matching display implementations.
fenix843mm.sourcePath = $(venu2.sourcePath)
fenix843mm.resourcePath = $(venu2.resourcePath)
fenix8solar51mm.sourcePath = $(fenix7x.sourcePath)
fenix8solar51mm.resourcePath = $(fenix7x.resourcePath)
fenix943mm.sourcePath = $(venu2.sourcePath)
fenix943mm.resourcePath = $(venu2.resourcePath)
fenix947mm.sourcePath = $(fr965.sourcePath)
fenix947mm.resourcePath = $(fr965.resourcePath)
fenix9pro43mm.sourcePath = $(venu2.sourcePath)
fenix9pro43mm.resourcePath = $(venu2.resourcePath)
fenix9pro47mm.sourcePath = $(fr965.sourcePath)
fenix9pro47mm.resourcePath = $(fr965.resourcePath)
fenix9prosolar51mm.sourcePath = $(fenix7x.sourcePath)
fenix9prosolar51mm.resourcePath = $(fenix7x.resourcePath)

# Fenix 9 Pro 51mm: FR965 OLED rendering scaled to 466x466.
fenix9pro51mm.sourcePath = $(srcBase);src-fenix9pro51mm-466x466
fenix9pro51mm.resourcePath = $(base.resourcePath);resources-round-466x466

# Original Venu: scaled FR965 artwork with API 3.3 compatible rendering.
venu.sourcePath = $(srcBase);src-venu-390x390
venu.resourcePath = $(base.resourcePath);resources-venu
