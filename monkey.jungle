fenix7s.resourcePath = $(base.resourcePath);resources-fenix7s
fenix7spro.sourcePath = $(fenix7s.sourcePath)
fenix7spro.resourcePath = $(fenix7s.resourcePath)

fenix7.sourcePath = $(srcBase);src-fenix7-260x260;src-weather-api
fenix7.resourcePath = $(base.resourcePath);resources-fenix7
fenix7pro.sourcePath = $(fenix7.sourcePath)
fenix7pro.resourcePath = $(fenix7.resourcePath)
fenix7pronowifi.sourcePath = $(fenix7.sourcePath)
fenix7pronowifi.resourcePath = $(fenix7.resourcePath)
