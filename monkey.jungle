fenix6pro.sourcePath = $(fenix6.sourcePath)
fenix6pro.resourcePath = $(fenix6.resourcePath)

# Fenix 6X uses Fenix 6 low-memory rendering with Fenix 7X artwork.
fenix6xpro.sourcePath = $(srcBase);src-fenix6x-280x280;src-weather-api-compact
fenix6xpro.resourcePath = $(base.resourcePath);resources-fenix6x

legacysagadarthvader.sourcePath = $(fenix6.sourcePath)
legacysagadarthvader.resourcePath = $(fenix6.resourcePath)

vivoactive4.sourcePath = $(srcBase);src-vivoactive4-260x260;src-weather-api-compact
vivoactive4.resourcePath = $(base.resourcePath);resources-vivoactive4

# Vivoactive 4S uses Fenix 6X low-memory rendering with native 218x218 artwork.
vivoactive4s.sourcePath = $(srcBase);src-vivoactive4s-218x218;src-weather-api-compact
vivoactive4s.resourcePath = $(base.resourcePath);resources-vivoactive4s
